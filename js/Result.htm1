<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Result - MasterHub</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
background:#f4f7fb;
font-family:Arial,sans-serif;
}
.result-card{
max-width:700px;
margin:40px auto;
background:#fff;
padding:30px;
border-radius:15px;
box-shadow:0 0 15px rgba(0,0,0,.1);
}
.score{
font-size:50px;
font-weight:bold;
color:#0d6efd;
}
</style>

</head>
<body>

<div class="result-card text-center">

<h2>🎉 Test Completed</h2>

<div class="score">80%</div>

<hr>

<div class="row mt-4">

<div class="col-6">
<h4>20</h4>
<p>Total Questions</p>
</div>

<div class="col-6">
<h4>16</h4>
<p>Correct Answers</p>
</div>

<div class="col-6 mt-3">
<h4>4</h4>
<p>Wrong Answers</p>
</div>

<div class="col-6 mt-3">
<h4>12 min</h4>
<p>Time Taken</p>
</div>

</div>

<a href="index.html" class="btn btn-primary mt-4">🏠 Go to Home</a>

<a href="test.html" class="btn btn-success mt-4">🔄 Retry Test</a>

</div>

</body>
  </html>
