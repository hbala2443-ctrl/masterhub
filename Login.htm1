<!DOCTYPE html>
<html>
<head>
<title>Login - MasterHub</title>
<style>
body{
font-family:Arial;
background:#f4f7fb;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
}

.box{
background:white;
padding:30px;
border-radius:15px;
box-shadow:0 0 10px #ccc;
width:300px;
}

input{
width:100%;
padding:10px;
margin:10px 0;
}

button{
width:100%;
padding:12px;
background:#0d6efd;
color:white;
border:none;
}
</style>
</head>

<body>

<div class="box">

<h2>Login</h2>

<input placeholder="Email">

<input type="password" placeholder="Password">

<button>Login</button>

</div>

</body>
</html>
